{
    "name": "rejuancse/zepblocks",
    "description": "Collection of custom Gutenberg blocks.",
    "type": "wordpress-plugin",
    "license": "GPLv2",
    "authors": [
        {
            "name": "Rejuan Ahamed"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "ZepBlocks\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZepBlocks\\Tests\\": "tests/php/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
